{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build"
    }
  ],
  "functions": {
    "src/pages/api/**/*.js": {
      "runtime": "nodejs20.x"
    },
    "api/users/**/*.js": {
      "maxDuration": 30
    }
  }
}